DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# On Render, set e.g. web-site-n1vp.onrender.com (or rely on auto .onrender.com)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# On Render/Vercel, add your frontend URL for CORS
DATABASE_ENGINE=postgres
# Required on Vercel / production (also accepts POSTGRES_URL from Vercel Postgres / Neon).
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgres://nexora:nexora@localhost:5432/nexora
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Nexora <noreply@localhost>
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_CURRENCY=INR
# Production (server only; never commit real values):
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
