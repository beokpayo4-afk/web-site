DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_ENGINE=postgres
# Prefer a real Postgres URL in production (Vercel also accepts POSTGRES_URL).
# Leave unset/empty on Vercel only for build discovery — runtime needs a DB.
DATABASE_URL=postgres://nexora:nexora@localhost:5432/nexora
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Nexora <noreply@localhost>
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_CURRENCY=INR
# Production (server only; never commit real values):
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
