# Copy to .env and fill in local values. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production (Render / Vercel): also set the exact host, e.g.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web-site-n1vp.onrender.com
# (.onrender.com / .vercel.app are added automatically on those platforms)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Production: include your frontend origin, e.g. https://your-app.vercel.app

# PostgreSQL is the source of truth. Tests may use SQLite automatically.
DATABASE_ENGINE=postgres
DATABASE_URL=postgres://nexora:nexora@localhost:5432/nexora

# Optional: use sqlite only for throwaway local experiments
# DATABASE_ENGINE=sqlite

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Nexora <noreply@localhost>

# Mock payments in development. Never put live payment credentials here or in the frontend.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_CURRENCY=INR

# Production only (server secrets manager / host env). Leave empty locally.
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1
